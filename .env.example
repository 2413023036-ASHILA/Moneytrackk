# ===================================================================
# MONEYTRACK - ENVIRONMENT VARIABLES TEMPLATE
# Salin file ini menjadi .env lalu isi dengan kredensial Anda.
# File .env TIDAK AKAN di-upload ke GitHub karena ada di .gitignore.
# ===================================================================

# 1. Supabase Database & Auth (Tahap 2)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-backend-only

# 2. OpenAI API (Tahap 3 - Financial Diagnostics)
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# 3. Google Gemini API (Tahap 4 - Financial Chatbot Assistant)
GEMINI_API_KEY=AIzaSy-your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
